# ==============================================================================
# KONFIGURASI BOT TELEGRAM & PENGARSIPAN
# ==============================================================================

# BOT_TOKEN: Token bot dari @BotFather di Telegram (WAJIB)
# Mendukung BOT_TOKEN atau TELEGRAM_BOT_TOKEN
BOT_TOKEN="your_telegram_bot_token_here"

# ARCHIVE_CHANNEL_ID: ID channel Telegram untuk tujuan pengiriman & pengarsipan lagu (WAJIB).
# Format valid: -100xxxxxxxxxx (angka supergroup/channel) atau @channelusername.
# Lagu akan dikirim langsung ke channel ini.
ARCHIVE_CHANNEL_ID="-1001234567890"

# SEND_AUDIO_TO_USER: Apakah file lagu audio juga dikirim ke chat bot pribadi pemohon?
# Default: false (lagu cukup dikirim ke channel saja, bot hanya mengirim progres & laporan).
# Setel 'true' jika ingin lagu dikirim ganda ke channel DAN chat bot pribadi.
SEND_AUDIO_TO_USER="false"

# ADMIN_USER_IDS: Daftar Telegram User ID admin yang dipisahkan tanda koma (opsional)
# Admin memiliki akses ke perintah /health, /stats, dan pembatalan antrean global.
ADMIN_USER_IDS="123456789,987654321"

# ==============================================================================
# KUALITAS DAN FORMAT AUDIO
# ==============================================================================

# AUDIO_QUALITY: Pemilihan stream yt-dlp (default: best -> bestaudio/best)
AUDIO_QUALITY="best"

# AUDIO_FORMAT: Format output file audio (default: mp3)
AUDIO_FORMAT="mp3"

# AUDIO_BITRATE: Bitrate MP3 dalam kbps (contoh: 192, 320, atau 0/best)
# Nilai "0" atau "best" akan mempertahankan kualitas sumber asli tanpa re-encode lossy.
AUDIO_BITRATE="0"

# ==============================================================================
# PIPELINE KONKURENSI, WORKER & LIMIT RESOURCE
# ==============================================================================

# DOWNLOAD_WORKERS: Jumlah worker thread pengunduh paralel (default: 2)
DOWNLOAD_WORKERS="2"

# UPLOAD_WORKERS: Jumlah worker thread pengunggah/pengarsip paralel (default: 2)
UPLOAD_WORKERS="2"

# MAX_QUEUE_SIZE: Kapasitas antrean buffer antara download dan upload (default: 5)
MAX_QUEUE_SIZE="5"

# MAX_USER_CONCURRENT_JOBS: Batas maksimal pekerjaan aktif/mengantre per pengguna (default: 3)
MAX_USER_CONCURRENT_JOBS="3"

# ==============================================================================
# TIMEOUT & KONEKSI TELEGRAM
# ==============================================================================

# BOT_API_TIMEOUT: Timeout koneksi API Telegram dalam detik (default: 60)
BOT_API_TIMEOUT="60"

# POLLING_TIMEOUT: Timeout polling Telegram getUpdates dalam detik (default: 30)
POLLING_TIMEOUT="30"

# LONG_POLLING_TIMEOUT: Timeout long polling Telegram dalam detik (default: 30)
LONG_POLLING_TIMEOUT="30"

# MAX_RETRIES: Batas percobaan ulang saat download/upload mengalami error (default: 3)
MAX_RETRIES="3"

# LOG_LEVEL: Level logging Python (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL="INFO"
