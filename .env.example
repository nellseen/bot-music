# TELEGRAM_BOT_TOKEN: Token bot Telegram yang didapatkan dari @BotFather di Telegram.
# WAJIB diatur agar bot Telegram dapat berjalan.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# AUDIO_BITRATE: Kualitas kompresi audio MP3 dalam kbps (default: 192)
AUDIO_BITRATE="192"

# MAX_RETRIES: Batas jumlah percobaan ulang saat lagu gagal diunduh sementara (default: 2)
MAX_RETRIES="2"

# LOG_LEVEL: Level logging Python (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL="INFO"
